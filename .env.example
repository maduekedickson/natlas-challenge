# Copy to .env and fill in real values. Never commit .env.

# Hugging Face access token with accepted access to NCAIR1/N-ATLaS
# (https://huggingface.co/settings/tokens)
HF_TOKEN=

MODEL_NAME=NCAIR1/N-ATLaS
MODEL_REVISION=

# Path to a trained LoRA adapter directory. Omit to serve the base model.
ADAPTER_PATH=training/output/lora-adapter/final
# Label recorded against every report for traceability -- bump this if you
# retrain a materially different adapter.
ADAPTER_VERSION=health-lora-v1

DEVICE=auto
API_HOST=0.0.0.0
API_PORT=8000

# SQLite file for report persistence. Point this at a mounted Google Drive
# path in Colab if you need it to survive a session restart.
DATABASE_PATH=data/app.db

# Whisper model size for voice-report transcription (tiny/base/small/medium)
WHISPER_MODEL=base

# Streamlit -> FastAPI (only needed on the Streamlit side)
API_BASE_URL=http://localhost:8000
